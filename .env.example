# ==============================================================================
# Data Collection Agent v1.1 - 환경 변수 설정 템플릿 (.env.example)
# ==============================================================================
# 이 파일을 복사하여 .env 파일을 생성하고 실제 환경에 맞는 값을 설정하세요.
# 주의: .env 파일은 실제 API 키와 DB 비밀번호를 포함하므로 절대 GitHub에 커밋하지 마세요.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TourAPI (한국관광공사 국문 관광정보 서비스)
# ------------------------------------------------------------------------------
# 공공데이터포털(https://www.data.go.kr)에서 '한국관광공사_국문 관광정보 서비스_GW' 활용신청 후 발급받은 키
# 중요: Encoding 키가 아닌 '일반(Decoding) 인증키'를 입력해야 합니다. (Node.js URLSearchParams가 자동 인코딩 수행)
TOUR_API_KEY=your_tour_api_decoding_key_here

# TourAPI OpenAPI 기본 엔드포인트 URL (공식 v4.4 기준 기본값)
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2

# API 연속 호출 시 딜레이 (ms, TourAPI 초당 요청 제한 및 차단 방지 권장값: 120 ~ 300)
TOUR_API_DELAY_MS=120

# 1회 수집 작업당 최대 API 호출 예산 한도 (무한 루프 방지용 안전장치)
TOUR_API_REQUEST_BUDGET=120

# 수집 대상 지역 법정동 시도코드 (부산: 26, 서울: 11, 제주: 50, 강원: 32 등)
TOUR_API_REGION_CODE=26

# 수집 대상 도시명 (DB 저장 및 RAG 청크 메타데이터에 반영)
TOUR_API_CITY=부산

# 1회 실행당 수집 대상 호텔 수 한도
COLLECTION_LIMIT=30

# ------------------------------------------------------------------------------
# 2. PostgreSQL + pgvector 데이터베이스
# ------------------------------------------------------------------------------
# Docker Compose (compose.yaml) 실행 시 기본 로컬 접속 URL
# 형식: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]
DATABASE_URL=postgresql://hotel:hotel@127.0.0.1:5432/hotel

# (선택) 수집 완료 후 data/exports 디렉터리로 CSV 자동 익스포트 여부 (기본값: true, 비활성화: false)
AUTO_EXPORT_CSV=true

# (선택) 격리된 임시 스키마 기반 PostgreSQL 통합 테스트 실행 시 사용하는 DB URL (미설정 시 실DB 테스트 skip)
# TEST_DATABASE_URL=postgresql://hotel:hotel@127.0.0.1:5432/hotel

# (선택) Docker Compose 컨테이너 생성 시 사용할 PostgreSQL 비밀번호 (기본값: hotel)
POSTGRES_PASSWORD=hotel
