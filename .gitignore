# Dependencies
node_modules/

# Build artifacts
dist/
*.tsbuildinfo

# Environment variables & secrets (CRITICAL: NEVER COMMIT)
.env
.env.*
.env.local
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test directories & Coverage
coverage/
data/test_exports_*

# Execution reports & Run logs (keep empty directory)
reports/*
!reports/.gitkeep

# Raw TourAPI API dumps (keep empty directory)
data/raw/tourapi/*
!data/raw/tourapi/.gitkeep

# CSV exports directory placeholder
!data/exports/.gitkeep

# OS & Editor generated files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.tmp
